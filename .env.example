# Deployment environment variables.
#
# Copy to `.env` for local use (it is git-ignored), or set these in the Render /
# Vercel dashboards. Every variable is optional: the service runs with none set.

# --------------------------------------------------------------- embeddings
# auto   = try the neural embedder, fall back to lexical
# neural = require the neural embedder and fail loudly
# lexical= force the dependency-free path (the deployed configuration)
CRA_EMBEDDER=lexical
# CRA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -------------------------------------------------------------- optional LLM
# Empty means no model, which is a supported configuration.
CRA_LLM_PROVIDER=
CRA_LLM_MODEL=gpt-4o-mini
CRA_LLM_API_KEY=
CRA_LLM_BASE_URL=
CRA_LLM_TIMEOUT_S=12
CRA_LLM_MAX_TOKENS=320

# ---------------------------------------------------------------- deployment
CRA_API_PORT=8003
CRA_WEB_PORT=5020
CRA_BIND_HOST=127.0.0.1
CRA_API_PUBLIC_URL=http://127.0.0.1:8003
CRA_WEB_PUBLIC_URL=http://127.0.0.1:5020
# Comma-separated. No wildcard: this API has no authentication.
CRA_ALLOWED_ORIGINS=http://127.0.0.1:5020,http://localhost:5020
# Optional regex for Vercel previews, e.g. ^https://cu-route-assistant-[a-z0-9-]+\.vercel\.app$
CRA_ALLOWED_ORIGIN_REGEX=
# Set true only behind a platform reverse proxy (Render, Fly, Railway).
CRA_TRUST_PROXY=false
CRA_API_TIMEOUT_S=20

# ------------------------------------------------------------------- storage
# Defaults are relative to backend/. Override only for a mounted volume.
# CRA_DATA_DIR=./data
# CRA_EVAL_DIR=./eval
# CRA_VAR_DIR=./var
